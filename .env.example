# Database (Postgres)
DATABASE_URL="postgresql://mocci:mocci@localhost:5432/mocci?schema=public"

# Redis (pub/sub untuk event pipeline)
REDIS_URL="redis://localhost:6379"

# Auth — generate dengan: openssl rand -base64 32 (min. 32 karakter)
AUTH_SECRET="change-me-minimum-32-characters-long!!"

# Server Actions: origin tambahan yang diizinkan saat aplikasi diakses lewat
# proxy/reverse-proxy (mis. preview Orca). Default next.config.ts sudah
# mencakup *.orca.* — isi di sini hanya bila memakai proxy lain, dipisah koma.
# SERVER_ACTIONS_ALLOWED_ORIGINS="app.example.com:8443,stage.example.com"
